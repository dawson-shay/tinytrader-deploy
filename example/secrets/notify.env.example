# Template for secrets/notify.env: placeholders only, never real values.
# The real file is sops-encrypted (secrets/README.md).
# Where the console and each host's monitor push notices: a private ntfy topic.
NTFY_URL=https://ntfy.sh/REPLACE-WITH-A-RANDOM-TOPIC-OF-32-OR-MORE-CHARACTERS
# Each host's healthchecks.io ping URL (one check per host; the inventory's
# monitoring.heartbeat names the keys).
HC_PING_DESK=https://hc-ping.com/00000000-0000-0000-0000-000000000000
HC_PING_VAULT=https://hc-ping.com/00000000-0000-0000-0000-000000000000
