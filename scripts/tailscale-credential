#!/usr/bin/env bash
# Store a Tailscale OAuth client in the site's secrets/tailscale.env,
# encrypted with sops, from a plain text file the operator saved it in:
#   line 1  the client ID
#   line 2  blank
#   line 3  the client secret
#   scripts/tailscale-credential [FILE]     default ~/secrets.txt
# Its scopes: Policy File (scripts/tailscale-policy's gitops, later), Devices
# Core write (scripts/tailscale-pin: rename, set the address, delete stale
# devices) and Auth Keys write (scripts/tailscale-join --tags), both with
# the inventory's tailnet.tag (and any other tag your hosts carry).
# Prints only the key names, never the values. The plain file is deleted
# once the encrypted copy decrypts to both keys.
set -euo pipefail
# shellcheck source=lib/site.sh
. "$(dirname "$0")/lib/site.sh"
export PATH="/run/current-system/sw/bin:$HOME/.nix-profile/bin:$PATH"
src="${1:-$HOME/secrets.txt}"
out="$site/secrets/tailscale.env"
[ -f "$src" ] || { echo "no such file: $src" >&2; exit 1; }

id="$(sed -n 1p "$src" | tr -d '[:space:]')"
blank="$(sed -n 2p "$src" | tr -d '[:space:]')"
secret="$(sed -n 3p "$src" | tr -d '[:space:]')"
[ -n "$id" ] && [ -z "$blank" ] && [ -n "$secret" ] || {
  echo "expected: the client ID on line 1, a blank line 2, the secret on line 3" >&2
  exit 1
}
case "$secret" in tskey-client-*) ;; *) echo "warning: line 3 doesn't look like a client secret (tskey-client-…)" >&2 ;; esac

printf 'TS_OAUTH_CLIENT_ID=%s\nTS_OAUTH_CLIENT_SECRET=%s\n' "$id" "$secret" |
  sops encrypt --filename-override "$out" --input-type dotenv --output-type dotenv /dev/stdin >"$out.tmp"
mv "$out.tmp" "$out"
unset id secret

keys="$(sops decrypt "$out" | cut -d= -f1 | sort | tr '\n' ' ')"
echo "secrets/tailscale.env holds: $keys"
[ "$keys" = "TS_OAUTH_CLIENT_ID TS_OAUTH_CLIENT_SECRET " ] || { echo "unexpected keys; kept $src" >&2; exit 1; }
rm -P "$src" 2>/dev/null || rm "$src"
echo "deleted $src"
