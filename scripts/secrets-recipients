#!/usr/bin/env bash
# Write the site's .sops.yaml from its inventory.nix `secrets`
# (docs/decisions/0004), then re-encrypt every file under its secrets/ to its
# recipients (the site is scripts/lib/site.sh's): the operator and
# recovery keys for everything, and each host only for the files granted to it.
# A `hostOnly` file (decision 0013) goes to its hosts and the recovery key
# only, never the operator key.
#   scripts/secrets-recipients            write .sops.yaml and re-encrypt
#   scripts/secrets-recipients --check    print what .sops.yaml would be; change nothing
# Re-encrypting needs the operator key (it decrypts each file to re-key it).
# A hostOnly file the operator key no longer opens is left as it is, and said
# so: re-key it on its host, `scripts/databento-key updatekeys` (sudo, with
# the host key). Hosts whose recipient isn't set yet are skipped, and said so.
set -euo pipefail
export PATH="/nix/var/nix/profiles/default/bin:$HOME/.nix-profile/bin:$PATH"
# shellcheck source=lib/site.sh
. "$(dirname "$0")/lib/site.sh"
cd "$site"
check=$([ "${1:-}" = --check ] && echo yes || echo no)

inv="$(nix eval --json --file inventory.nix secrets)"

# One rule per file pattern: the operator (unless the file is hostOnly), the
# recovery key if set, and the hosts granted it whose recipient is known. A
# catch-all rule last gives any other file the operator and recovery keys only.
yaml="$(jq -r '
  . as $s
  | def everyone: [$s.operator, $s.recovery] | map(select(. != null));
    def hostOnly: . as $f | ($s.hostOnly // []) | index($f) != null;
    def rx: "^secrets/" + (gsub("\\."; "\\.") | gsub("\\*"; "[^/]*")) + "$";
  "# Written by scripts/secrets-recipients from inventory.nix (docs/decisions/0004).",
  "# Edit inventory.nix, not this file.",
  "creation_rules:",
  ( $s.files | to_entries[]
    | (if (.key | hostOnly) then [$s.recovery] | map(select(. != null)) else everyone end) as $base
    | ($base + [.value[] | $s.hosts[.] // empty]) as $who
    | (if (.key | hostOnly) then "  # hostOnly (docs/decisions/0013): its hosts and the recovery key, never the operator key." else empty end),
      "  - path_regex: \(.key | rx)",
      "    age: >-",
      "      \($who | join(","))" ),
  "  - path_regex: ^secrets/",
  "    age: >-",
  "      \(everyone | join(","))"
' <<<"$inv")"

missing="$(jq -r '. as $s | [$s.files[][]] | unique[] | select($s.hosts[.] == null)' <<<"$inv")"
[ -n "$missing" ] && echo "not yet a recipient (no key in inventory.nix): $(echo $missing)" >&2
[ "$(jq -r '.recovery' <<<"$inv")" = null ] && echo "no recovery key yet: inventory.nix secrets.recovery" >&2
# A hostOnly file no host could decrypt would be the recovery key's alone.
nobody="$(jq -r '. as $s | ($s.hostOnly // [])[] | select([($s.files[.] // [])[] | $s.hosts[.] // empty] | length == 0)' <<<"$inv")"
if [ -n "$nobody" ]; then
  echo "hostOnly with no host recipient (inventory.nix secrets): $nobody" >&2
  exit 1
fi

if [ "$check" = yes ]; then
  printf '%s\n' "$yaml"
  exit 0
fi

printf '%s\n' "$yaml" > .sops.yaml
echo "wrote .sops.yaml"
operator="$(jq -r .operator <<<"$inv")"
host_only="$(jq -r '(.hostOnly // [])[] | "^secrets/" + (gsub("\\."; "\\.") | gsub("\\*"; "[^/]*")) + "$"' <<<"$inv")"
find secrets -type f ! -name README.md ! -name '*.example' | sort | while read -r f; do
  # A hostOnly file is re-keyed here only while the operator key is still
  # one of its recipients (the first time: it drops it).
  if [ -n "$host_only" ] && grep -Eq -f <(printf '%s\n' "$host_only") <<<"$f" && ! grep -qF "$operator" "$f"; then
    echo "  left $f as it is (hostOnly: re-key it on its host, scripts/databento-key updatekeys)"
    continue
  fi
  sops updatekeys --yes "$f" >/dev/null 2>&1 && echo "  re-encrypted $f" || { echo "  could not re-encrypt $f" >&2; exit 1; }
done
