#!/usr/bin/env bash
# backup-state: this host's tinytrader state, copied into one dated folder,
# with retention and an encrypted copy on another host (docs/operations.md
# "Backups", "Restore from backup"). Nightly it runs as the `backup` service
# (the site's inventory; modules/backup-darwin.nix, modules/nas.nix); by hand
# (from a stack checkout, TINYTRADER_SITE naming the site):
#
#   scripts/backup-state [--dry-run] [DEST]   one snapshot (default: a new folder under
#                                             BACKUP_ROOT, ~/Backups/tinytrader)
#   scripts/backup-state --scheduled          the nightly job: snapshot, prune, off-host copy
#   scripts/backup-state --prune [--dry-run]  apply the retention only
#   scripts/backup-state --offhost            send the newest snapshot off the host again
#   scripts/backup-state --list-volumes       the volumes it would copy, and why
#
# --dry-run says what it would copy, pause, prune and send, and writes nothing.
#
# What a snapshot holds:
# - volumes/<v>.tar: every named volume of the Compose project, as a tar made
#   as root inside a throwaway container (owners and modes kept, so a restore
#   is exact). The list is compose.yaml's `volumes:` (none hard-coded), plus
#   any other volume labelled with the project (an old one compose.yaml no
#   longer names is copied too, and said so). For consistency, the running
#   containers that mount a volume are paused (`docker pause`, a freeze, not a
#   stop) for the second or two its tar takes, then unpaused: the copy is what
#   a power cut at that instant would leave, which each service recovers from.
#   Order gateways are never paused (they hold no named volume anyway).
# - order-gateway/: the gateways' state roots (~/.local/state/order-gateway),
#   copied live, never stopping a gateway. Each journal is append-only, one
#   file per UTC day, each line fsync'd before its effect, and closed days are
#   never rewritten (tinytrader services/order-gateway, journal.rs), so any
#   copy is a prefix of the journal plus at most one torn line at the end of
#   the newest file. The copy cuts that partial line (as the gateway itself
#   does on start) and then verifies the hash chain and `seq` of every
#   account; a broken chain fails the backup. The KILL sentinel is kept, the
#   lock file is not.
# - repos/: the site, this stack and tinytrader, with .git and uncommitted
#   files, without build output (hard-linked to the previous snapshot where
#   unchanged): the deploy checkouts the services run from where there are
#   some (TINYTRADER_DEPLOY_ROOT, decision 0012), else BACKUP_REPOS
#   (~/repos). The site holds the console's reminders, curated views and journal
#   (state/console, decision 0009), so edits not yet committed are in the
#   snapshot too; the console's settings and profiles are in its volume
#   (console-data).
# - MANIFEST.json (what was copied, each gateway's last seq) and SHA256SUMS
#   (every file but the repositories', which git hashes).
#
# Not in it: market data (the store's drives), and no key of any kind. The
# sops age key is NOT copied (it used to be): secrets are decrypted with the
# operator key, kept on the machines you sit at and in a password manager, or the
# recovery key (the inventory's secrets.recovery), kept offline.
#
# Retention (--scheduled, --prune): the newest snapshot of each of the last
# BACKUP_KEEP_DAILY days that have one, and of each of the last
# BACKUP_KEEP_WEEKLY ISO weeks that have one; others are deleted, the newest
# never.
#
# The off-host copy (--scheduled, --offhost; BACKUP_OFFHOST=user@host): the
# newest snapshot as one tar, zstd-compressed and age-encrypted to
# BACKUP_RECIPIENTS (the operator and recovery keys' public halves), sent with
# rsync over SSH with this host's backup key (BACKUP_SSH_KEY). The receiving
# host accepts that key only for rrsync, write-only, into one directory
# (modules/backup-darwin.nix), and keeps the same snapshots as here: older
# ones are deleted there as they are pruned here. Without recipients nothing
# is sent: never plain text off the host.
#
# After a scheduled run it stamps BACKUP_STATE/last-backup and last-offhost;
# the monitor alerts when either is older than the inventory's
# monitoring.backup.maxAgeHours.
set -euo pipefail

usage() {
  sed -n '7,13p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2
  exit 2
}

# The tools come from the site's flake (packages.<system>.backup-state, made
# by this stack's lib.mkDeployment). Run from a checkout, re-run through it.
if [ -z "${BACKUP_STATE_PACKAGED:-}" ]; then
  export PATH="/nix/var/nix/profiles/default/bin:$HOME/.nix-profile/bin:$PATH"
  # shellcheck disable=SC1091 # (from a checkout only: the package never gets here)
  . "$(dirname "${BASH_SOURCE[0]}")/lib/site.sh"
  exec nix run "$TINYTRADER_SITE#backup-state" -- "$@"
fi

mode=snapshot
dry=0
dest=""
for a in "$@"; do
  case "$a" in
    --dry-run) dry=1 ;;
    --scheduled) mode=scheduled ;;
    --prune) mode=prune ;;
    --offhost) mode=offhost ;;
    --list-volumes) mode=list ;;
    -h | --help) usage ;;
    -*) usage ;;
    *) [ -z "$dest" ] || usage; dest="$a" ;;
  esac
done

root="${BACKUP_ROOT:-$HOME/Backups/tinytrader}"
state="${BACKUP_STATE:-$HOME/.local/state/tinytrader-backup}"
project="${BACKUP_PROJECT:-tinytrader}" # the deployment's name (the site's compose project), set by the flake
compose="${BACKUP_COMPOSE:-}" # the packaged compose.yaml, set by the flake
# The repositories: the deploy checkouts where this machine has them (the
# services run from those, with the console's state; docs/decisions/0012:
# <root>/<the deployment's name>, <root>/tinytrader-deploy, <root>/tinytrader),
# else the working copies in BACKUP_REPOS.
deploy_root="${TINYTRADER_DEPLOY_ROOT:-$HOME/.local/share/tinytrader/deploy}"
if [ -e "$deploy_root/$project/.git" ]; then repos="$deploy_root"; else repos="${BACKUP_REPOS:-$HOME/repos}"; fi
src="${TINYTRADER_SRC:-$repos/tinytrader}"
site="${TINYTRADER_SITE:-$repos/$project}"
stack="${TINYTRADER_DEPLOY:-$repos/tinytrader-deploy}"
gw="${BACKUP_GATEWAY_STATE:-$HOME/.local/state/order-gateway}"
docker_on="${BACKUP_DOCKER:-1}"         # 0 on a host with no Docker engine (the NAS)
extra_paths="${BACKUP_EXTRA_PATHS:-}"   # more directories to copy whole (the NAS's /var/lib/tinytrader)
keep_daily="${BACKUP_KEEP_DAILY:-14}"
keep_weekly="${BACKUP_KEEP_WEEKLY:-8}"
min_free_gib="${BACKUP_MIN_FREE_GIB:-10}"
offhost="${BACKUP_OFFHOST:-}"
ssh_key="${BACKUP_SSH_KEY:-$HOME/.ssh/tinytrader-backup}"
recipients="${BACKUP_RECIPIENTS:-}"
helper_image="${BACKUP_HELPER_IMAGE:-alpine:3}"
stamp_re='^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{4}$'

log() { printf 'backup-state: %s\n' "$*" >&2; }
die() { log "$*"; exit 1; }
would() { log "would $*"; }
umask 077

# ---------------------------------------------------------------- volumes

# The project's volumes: <short name><TAB><docker name><TAB><why>.
volumes() {
  local listed="" k n
  if [ -n "$compose" ]; then
    [ -r "$compose" ] || die "no compose file at $compose"
    while IFS=$'\t' read -r k n; do
      [ -n "$k" ] || continue
      [ -n "$n" ] || n="${project}_$k"
      printf '%s\t%s\tcompose.yaml\n' "$k" "$n"
      listed+="$n"$'\n'
    done < <(yq -r '(.volumes // {}) | to_entries[] | [.key, (.value.name // "")] | @tsv' "$compose")
  fi
  [ "$docker_on" = 1 ] || return 0
  # Volumes the engine has for this project that compose.yaml doesn't name.
  while read -r n; do
    [ -n "$n" ] || continue
    grep -qxF "$n" <<<"$listed" && continue
    printf '%s\t%s\tlabelled %s, not in compose.yaml\n' "${n#"${project}"_}" "$n" "$project"
  done < <(docker volume ls -q --filter "label=com.docker.compose.project=$project")
}

paused=()
locked=0
cleanup() {
  unpause_all
  [ "$locked" = 0 ] || rm -rf "$state/lock"
}
trap cleanup EXIT
trap 'cleanup; exit 130' INT TERM
unpause_all() {
  local c
  for c in "${paused[@]}"; do
    docker unpause "$c" >/dev/null 2>&1 || log "WARNING: could not unpause container $c: unpause it by hand"
  done
  paused=()
}

copy_volumes() { # DEST
  local d="$1" k n why users c svc uid gid count=0 missing=0
  uid="$(id -u)"; gid="$(id -g)"
  [ "$dry" = 1 ] || mkdir -p "$d/volumes"
  while IFS=$'\t' read -r k n why; do
    if ! docker volume inspect "$n" >/dev/null 2>&1; then
      log "volume $k: not on this engine ($why): nothing to copy"
      missing=$((missing + 1))
      volumes_json+="$(jq -cn --arg k "$k" --arg n "$n" '{($k): {volume: $n, copied: false}}')"
      continue
    fi
    # The running containers that mount it: paused while it is copied.
    users=()
    while read -r c; do
      [ -n "$c" ] || continue
      svc="$(docker inspect -f '{{index .Config.Labels "com.docker.compose.service"}}' "$c")"
      [ -n "$svc" ] || svc="$(docker inspect -f '{{.Name}}' "$c" | tr -d /)"
      case "$svc" in
        order-gateway*)
          log "volume $k: mounted by $svc: copied without pausing it (a gateway is never paused)"
          continue ;;
      esac
      users+=("$c")
    done < <(docker ps -q --filter "volume=$n" --filter status=running)
    if [ "$dry" = 1 ]; then
      would "copy volume $k ($n, $why)${users[*]:+, pausing $(docker inspect -f '{{.Name}}' "${users[@]}" | tr -d / | paste -sd, -)}"
      count=$((count + 1))
      continue
    fi
    if [ "${#users[@]}" -gt 0 ]; then
      docker pause "${users[@]}" >/dev/null
      paused=("${users[@]}")
    fi
    if ! docker run --rm --network none -v "$n:/src:ro" -v "$d/volumes:/dst" "$helper_image" \
      sh -c "tar -C /src --numeric-owner -cpf /dst/$k.tar . && chown $uid:$gid /dst/$k.tar"; then
      unpause_all
      die "volume $k: the copy failed"
    fi
    unpause_all
    log "copied volume $k ($(du -h "$d/volumes/$k.tar" | cut -f1)${users[*]:+, ${#users[@]} container(s) paused})"
    volumes_json+="$(jq -cn --arg k "$k" --arg n "$n" --arg why "$why" --argjson p "${#users[@]}" \
      '{($k): {volume: $n, copied: true, source: $why, paused: $p}}')"
    count=$((count + 1))
  done < <(volumes)
  log "$count volume(s)$([ "$missing" -eq 0 ] || echo ", $missing not on this engine")"
}

# ---------------------------------------------------------------- journals

# Cut a torn final line from the newest file of each journal in a copy, then
# verify every chain. Prints {account: {last_seq, files}} as JSON.
verify_journals() { # DIR
  python3 -I - "$1" <<'PY'
import hashlib, json, os, sys
root = sys.argv[1]
zero = "0" * 64
out, bad = {}, []
for acct in sorted(os.listdir(root)):
    jdir = os.path.join(root, acct, "journal")
    if not os.path.isdir(jdir):
        continue
    names = sorted(n for n in os.listdir(jdir) if len(n) == 16 and n.endswith(".jsonl"))
    last_hash, last_seq, cut = zero, 0, 0
    for i, name in enumerate(names):
        path = os.path.join(jdir, name)
        with open(path, "rb") as f:
            data = f.read()
        if i == len(names) - 1 and data and not data.endswith(b"\n"):
            keep = data.rfind(b"\n") + 1
            cut = len(data) - keep
            data = data[:keep]
            # A new file, never a truncate: the old one may be hard-linked
            # into an earlier snapshot.
            tmp = path + ".cut"
            with open(tmp, "wb") as f:
                f.write(data)
            os.replace(tmp, path)
        for n, raw in enumerate(data.splitlines(keepends=True), 1):
            body = raw[:-1].decode("utf-8")
            want = ',"prev":"%s"}' % last_hash
            if not body.endswith(want):
                bad.append(f"{acct}/{name} line {n}: hash chain mismatch")
                break
            seq = json.loads(body[: -len(want)] + "}").get("seq")
            if seq != last_seq + 1:
                bad.append(f"{acct}/{name} line {n}: seq {seq} after {last_seq}")
                break
            last_seq, last_hash = seq, hashlib.sha256(raw).hexdigest()
        else:
            continue
        break
    out[acct] = {"last_seq": last_seq, "files": len(names), "torn_bytes_cut": cut}
for b in bad:
    print("journal: " + b, file=sys.stderr)
print(json.dumps(out))
sys.exit(1 if bad else 0)
PY
}

copy_gateways() { # DEST PREVIOUS
  local d="$1" prev="$2" link=()
  if [ ! -d "$gw" ]; then
    log "no order-gateway state at $gw"
    return 0
  fi
  if [ "$dry" = 1 ]; then
    would "copy the gateways' state from $gw, live: $(find "$gw" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort | paste -sd' ' -)"
    return 0
  fi
  [ -n "$prev" ] && [ -d "$prev/order-gateway" ] && link=(--link-dest="$prev/order-gateway")
  rsync -a --exclude lock --exclude '*.cut' "${link[@]}" "$gw/" "$d/order-gateway/"
  if ! journals_json="$(verify_journals "$d/order-gateway")"; then
    die "the gateways' journals don't verify (above): this snapshot is incomplete. Look at the live journal before anything else."
  fi
  log "copied the gateways' state: $(jq -r 'to_entries | map("\(.key) seq \(.value.last_seq)") | join(", ")' <<<"$journals_json")"
}

# ---------------------------------------------------------------- the rest

copy_repos() { # DEST PREVIOUS
  local d="$1" prev="$2" r name link
  for r in "$src" "$stack" "$site"; do
    name="$(basename "$r")"
    if [ ! -d "$r/.git" ] && [ ! -f "$r/.git" ]; then
      log "no repository at $r"
      continue
    fi
    if [ "$dry" = 1 ]; then would "copy repository $name from $r"; continue; fi
    mkdir -p "$d/repos"
    link=()
    [ -n "$prev" ] && [ -d "$prev/repos/$name" ] && link=(--link-dest="$prev/repos/$name")
    rsync -a --exclude target --exclude 'result*' --exclude .direnv --exclude .venv --exclude node_modules \
      "${link[@]}" "$r/" "$d/repos/$name/"
    log "copied repository $name"
  done
}

copy_extra() { # DEST
  local d="$1" p
  for p in $extra_paths; do
    if [ ! -d "$p" ]; then log "no $p"; continue; fi
    if [ "$dry" = 1 ]; then would "copy $p"; continue; fi
    mkdir -p "$d/paths"
    rsync -a "$p/" "$d/paths/$(tr / _ <<<"${p#/}")/"
    log "copied $p"
  done
}

snapshots() { # newest first
  [ -d "$root" ] || return 0
  find "$root" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | grep -E "$stamp_re" | sort -r || true
}

free_gib() { df -Pk "$1" | awk 'NR == 2 { print int($4 / 1048576) }'; }

snapshot() {
  local name d final prev host
  host="${BACKUP_HOST:-$(uname -n | cut -d. -f1)}"
  name="$(date +%Y-%m-%d-%H%M)"
  if [ -n "$dest" ]; then final="$dest"; else final="$root/$name"; fi
  prev="$(snapshots | head -n1)"
  [ -z "$prev" ] || prev="$root/$prev"
  [ ! -e "$final" ] || die "$final exists already"
  d="$(dirname "$final")/.partial-$(basename "$final")"
  if [ "$dry" = 1 ]; then
    log "dry run: a snapshot into $final${prev:+ (unchanged files linked to $(basename "$prev"))}"
  else
    mkdir -p "$(dirname "$final")"
    chmod 700 "$(dirname "$final")" 2>/dev/null || true
    local free
    free="$(free_gib "$(dirname "$final")")"
    [ "$free" -ge "$min_free_gib" ] || die "only $free GiB free under $(dirname "$final") (needs $min_free_gib): not filling the disk"
    rm -rf "$d"
    mkdir -m 700 "$d"
  fi
  volumes_json="" journals_json="{}"
  if [ "$docker_on" = 1 ]; then
    docker info >/dev/null 2>&1 || die "the Docker engine isn't answering (DOCKER_HOST=${DOCKER_HOST:-default}): no snapshot"
    copy_volumes "$d"
  fi
  copy_gateways "$d" "$prev"
  copy_repos "$d" "$prev"
  copy_extra "$d"
  [ "$dry" = 0 ] || return 0
  jq -n --arg host "$host" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg site "$(git -C "$site" rev-parse HEAD 2>/dev/null || echo unknown)" \
    --arg stack "$(git -C "$stack" rev-parse HEAD 2>/dev/null || echo unknown)" \
    --arg project "$project" \
    --argjson volumes "$(printf '%s' "$volumes_json" | jq -s 'add // {}')" \
    --argjson gateways "$journals_json" \
    '{format: "tinytrader-deploy.backup/1", host: $host, at: $at, project: $project, site: $site, stack: $stack,
      volumes: $volumes, gateways: $gateways}' > "$d/MANIFEST.json"
  (cd "$d" && find . -type f ! -path './repos/*' -print0 | sort -z | xargs -0 sha256sum) > "$d.sums"
  mv "$d.sums" "$d/SHA256SUMS"
  chmod -R go-rwx "$d"
  mv "$d" "$final"
  log "snapshot $final ($(du -sh "$final" | cut -f1) on disk, $(du -sh --apparent-size "$final" | cut -f1) of files)"
}

# ---------------------------------------------------------------- retention

# The snapshots to keep, one per line, newest first.
keep_list() {
  local s day week days="" weeks="" nd=0 nw=0 first=1
  while read -r s; do
    [ -n "$s" ] || continue
    day="${s:0:10}"
    week="$(date -d "$day" +%G-W%V)"
    local keep=0
    if [ "$first" = 1 ]; then keep=1; first=0; fi
    if ! grep -qxF "$day" <<<"$days" && [ "$nd" -lt "$keep_daily" ]; then
      days+="$day"$'\n'; nd=$((nd + 1)); keep=1
    fi
    if ! grep -qxF "$week" <<<"$weeks" && [ "$nw" -lt "$keep_weekly" ]; then
      weeks+="$week"$'\n'; nw=$((nw + 1)); keep=1
    fi
    [ "$keep" = 0 ] || echo "$s"
  done < <(snapshots)
}

prune() {
  local keep s p
  keep="$(keep_list)"
  while read -r s; do
    [ -n "$s" ] || continue
    grep -qxF "$s" <<<"$keep" && continue
    if [ "$dry" = 1 ]; then would "delete snapshot $s (retention)"; continue; fi
    chmod -R u+w "$root/$s"
    rm -rf "${root:?}/$s"
    log "deleted snapshot $s (retention: $keep_daily daily, $keep_weekly weekly)"
  done < <(snapshots)
  # A snapshot that never finished (the job was killed).
  for p in "$root"/.partial-*; do
    [ -e "$p" ] || continue
    if [ "$dry" = 1 ]; then would "delete the unfinished $(basename "$p")"; continue; fi
    chmod -R u+w "$p"; rm -rf "$p"
    log "deleted the unfinished $(basename "$p")"
  done
  log "keeping $(grep -c . <<<"$keep" || true) snapshot(s)"
}

# ---------------------------------------------------------------- off-host

send_offhost() {
  local name out file filters=() r rargs=() keep
  [ -n "$offhost" ] || { log "no off-host copy (BACKUP_OFFHOST is empty)"; return 0; }
  name="$(snapshots | head -n1)"
  [ -n "$name" ] || die "no snapshot to send"
  for r in $recipients; do rargs+=(-r "$r"); done
  [ "${#rargs[@]}" -gt 0 ] || die "no age recipients (BACKUP_RECIPIENTS): refusing to send a snapshot in plain text"
  [ -r "$ssh_key" ] || die "no backup SSH key at $ssh_key (docs/operations.md \"Backups\": make it once with ssh-keygen)"
  keep="$(keep_list)"
  while read -r r; do
    [ -n "$r" ] && filters+=(--filter "P /$r.tar.zst.age")
  done <<<"$keep"
  if [ "$dry" = 1 ]; then
    would "send $name, encrypted to $(( ${#rargs[@]} / 2 )) recipient(s), to $offhost, and delete there what isn't one of: $(paste -sd' ' - <<<"$keep")"
    return 0
  fi
  out="$root/.outbox"
  rm -rf "$out"; mkdir -m 700 "$out"
  file="$out/$name.tar.zst.age"
  tar -C "$root" -cf - "$name" | zstd -q -T0 -10 | age "${rargs[@]}" > "$file.tmp"
  mv "$file.tmp" "$file"
  mkdir -p "$state"
  # Only what is sent and kept there: the receiver's forced command (rrsync,
  # write-only, one directory) refuses anything else.
  # (BACKUP_RSYNC_RSH replaces the ssh command, for tests.)
  if ! rsync -rt --delete "${filters[@]}" --chmod=Du=rwx,Dgo=,Fu=rw,Fgo= --timeout=600 \
    -e "${BACKUP_RSYNC_RSH:-ssh -i $ssh_key -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=30 -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=$state/known_hosts}" \
    "$out/" "$offhost:"; then
    rm -rf "$out"
    die "the off-host copy to $offhost failed"
  fi
  log "sent $name to $offhost ($(du -h "$file" | cut -f1) encrypted)"
  rm -rf "$out"
  touch "$state/last-offhost"
}

# ---------------------------------------------------------------- main

lock() {
  mkdir -p "$state"
  if ! mkdir "$state/lock" 2>/dev/null; then
    local pid
    pid="$(cat "$state/lock/pid" 2>/dev/null || true)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then die "another backup-state is running (pid $pid)"; fi
    rm -rf "$state/lock"; mkdir "$state/lock"
  fi
  echo $$ > "$state/lock/pid"
  locked=1
}

case "$mode" in
  list)
    volumes | while IFS=$'\t' read -r k n why; do printf '%-28s %-44s %s\n' "$k" "$n" "$why"; done
    ;;
  snapshot)
    [ "$dry" = 1 ] || lock
    snapshot
    ;;
  prune)
    prune
    ;;
  offhost)
    [ "$dry" = 1 ] || lock
    send_offhost
    ;;
  scheduled)
    [ -z "$dest" ] || usage
    [ "$dry" = 1 ] || lock
    log "start ($(date))"
    snapshot
    [ "$dry" = 1 ] || touch "$state/last-backup"
    prune
    send_offhost
    log "done ($(date))"
    ;;
esac
